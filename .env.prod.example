# Plantilla de .env.prod. NO la rellenes a mano: `scripts/bootstrap-secure.sh` genera .env.prod (permisos 600,
# fuera de git) con contraseñas aleatorias fuertes. Se deja aquí sólo para documentar las variables.
# Las variables OBLIGATORIAS no tienen valor por defecto: docker-compose.prod.yml aborta si están vacías (${VAR:?}).
# (Sin comentarios en la misma línea que un valor: compose los leería como parte del valor.)
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod --profile apps up -d --build

# --- Proxy / dominio (Caddy, única entrada HTTP(S)) ---
# Dominio público; con uno real, Caddy obtiene el certificado por ACME.
CAMPO_DOMAIN=localhost
# internal = CA interna de Caddy; con dominio real: tu email (contacto ACME).
CAMPO_TLS=internal
# Un año con dominio real: max-age=31536000;includeSubDomains
CAMPO_HSTS=max-age=300
# Puertos publicados por Caddy (opcionales):
# CAMPO_HTTP_PORT=80
# CAMPO_HTTPS_PORT=443
# Certificados, passwd de Mosquitto y contraseñas por planta:
SECRETS_DIR=./secrets

# --- TimescaleDB ---
POSTGRES_USER=campo
POSTGRES_DB=campo
# OBLIGATORIA
POSTGRES_PASSWORD=

# --- Redis ---
# OBLIGATORIA
REDIS_PASSWORD=

# --- API ---
# OBLIGATORIA, >= 48 caracteres aleatorios
JWT_SECRET=
# Caducidad del token de acceso (por defecto 1h en el compose endurecido)
# JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@campo.local
# OBLIGATORIA; sólo siembra el admin la primera vez
ADMIN_PASSWORD=

# --- MQTT (broker TLS en el puerto 8883) ---
# Puerto publicado (opcional)
# MQTT_TLS_PORT=8883
# OBLIGATORIA: contraseña del usuario `ingest`
MQTT_INGEST_PASSWORD=
# Perfil sim: el simulador publica como el usuario de esta planta
MQTT_SIM_PLANT=demo
# OBLIGATORIA
MQTT_SIM_PASSWORD=
