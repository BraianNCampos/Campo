# Copiar a .env (no se versiona). Referencia completa en README.md
NODE_ENV=development
PORT=3001
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
DATABASE_URL=postgres://campo:campo_dev@localhost:5432/campo
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Admin semilla (se crea al arrancar si no existe). Cambiar la contraseña en cualquier entorno compartido.
ADMIN_EMAIL=admin@campo.local
ADMIN_PASSWORD=cambia-esta-contrasena
# Autorización: caché de usuario/plantas (ms, 0-30000; 0 = sin caché) y duración del token.
# En producción JWT_SECRET/ADMIN_PASSWORD no pueden ser valores de ejemplo (ver README).
#AUTH_CACHE_TTL_MS=30000
#JWT_EXPIRES_IN=1h
